{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "gradleCommand": ":app:bundleMobileRelease"
      }
    },
    "production-automotive": {
      "extends": "production",
      "autoIncrement": true,
      "android": {
        "gradleCommand": ":app:bundleAutomotiveRelease"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6792056685"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "production-automotive": {
      "android": {
        "track": "automotive:production",
        "releaseStatus": "completed"
      }
    },
    "internal": {
      "android": {
        "track": "internal"
      }
    },
    "internal-automotive": {
      "android": {
        "track": "automotive:internal"
      }
    }
  }
}
