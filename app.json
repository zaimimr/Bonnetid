{
  "expo": {
    "name": "Bønnetid",
    "slug": "bonnetid",
    "version": "1.9.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bonnetid",
    "userInterfaceStyle": "automatic",
    "locales": {
      "nb": "./locales/nb.json",
      "en": "./locales/en.json",
      "ar": "./locales/ar.json",
      "ur": "./locales/ur.json"
    },
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "no.irn.bonnetid",
      "appleTeamId": "9L246T935B",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.no.irn.bonnetid"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "fetch"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "no.irn.bonnetid.refresh"
        ],
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1714",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "no.irn.bonnetid",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1714",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/splash-icon-android.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bønnetid bruker posisjonen din til å finne moskeer i nærheten og retningen mot Qibla."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bønnetid bruker kameraet til å vise retningen mot Qibla i AR-visning.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan.wav",
            "./assets/sounds/adhan_kort.wav",
            "./assets/sounds/adhan_full.mp3"
          ]
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withCarFormFactors",
      "./plugins/withWearOs",
      "./plugins/withTrimmedPermissions",
      "./plugins/withUnlockedOrientation",
      "./plugins/withR8Optimization",
      "./plugins/withPodDeploymentTarget",
      "./plugins/withSceneLifecycle",
      "./plugins/withSiriShortcuts",
      "./plugins/withCarPlay",
      "expo-image",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": ["nb", "en", "ar", "ur"]
        }
      ],
      [
        "posthog-react-native/expo",
        {
          "dotenvFile": ".env",
          "skipOnConflict": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67fb9aae-a57b-45c5-9c21-3cac544ffa2f"
      }
    },
    "owner": "zaim"
  }
}
