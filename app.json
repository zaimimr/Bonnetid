{
  "expo": {
    "name": "Bønnetid",
    "slug": "bonnetid",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bonnetid",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1714"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.irn.bonnetid",
      "appleTeamId": "9L246T935B",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.no.irn.bonnetid"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1714",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "no.irn.bonnetid",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1714",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bønnetid bruker posisjonen din til å finne moskeer i nærheten og retningen mot Qibla."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bønnetid bruker kameraet til å vise retningen mot Qibla i AR-visning."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan.wav",
            "./assets/sounds/adhan_kort.wav"
          ]
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      [
        "@sentry/react-native/expo",
        {
          "organization": "zaim-imran",
          "project": "bonnetid"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67fb9aae-a57b-45c5-9c21-3cac544ffa2f"
      }
    },
    "owner": "zaim"
  }
}
