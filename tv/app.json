{
  "expo": {
    "name": "Bønnetid TV",
    "slug": "bonnetid",
    "owner": "zaim",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "no.irn.bonnetid",
      "appleTeamId": "9L246T935B",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "no.irn.bonnetid",
      "versionCode": 2010000
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "tvosDeploymentTarget": "16.4",
          "appleTVImages": {
            "iconLayers": {
              "front": "./assets/tvos/icon-front.png",
              "back": "./assets/tvos/icon-back.png"
            },
            "iconSmallLayers": {
              "front": "./assets/tvos/iconSmall-front.png",
              "back": "./assets/tvos/iconSmall-back.png"
            },
            "iconSmall2xLayers": {
              "front": "./assets/tvos/iconSmall2x-front.png",
              "back": "./assets/tvos/iconSmall2x-back.png"
            },
            "topShelf": "./assets/tvos/topShelf.png",
            "topShelf2x": "./assets/tvos/topShelf2x.png",
            "topShelfWide": "./assets/tvos/topShelfWide.png",
            "topShelfWide2x": "./assets/tvos/topShelfWide2x.png"
          },
          "androidTVRequired": true,
          "androidTVBanner": "./assets/tvos/banner.png",
          "androidTVIcon": "./assets/tvos/android-icon.png"
        }
      ],
      "expo-font",
      "../plugins/withSceneLifecycle.js"
    ]
  }
}
