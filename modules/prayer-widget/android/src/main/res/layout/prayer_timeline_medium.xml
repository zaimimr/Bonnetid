<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_background"
  android:paddingStart="14dp"
  android:paddingEnd="14dp"
  android:paddingTop="12dp"
  android:paddingBottom="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/location"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_muted"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Oslo" />

    <TextView
      android:id="@+id/countdown_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_marginEnd="4dp"
      android:textSize="13sp"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:maxLines="1"
      android:text="Asr" />

    <Chronometer
      android:id="@+id/countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="13sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:fontFeatureSettings="tnum"
      android:maxLines="1" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/headline_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:orientation="horizontal"
    android:baselineAligned="true">

    <TextView
      android:id="@+id/headline_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="26sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_brand"
      android:letterSpacing="-0.02"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Dhuhr" />

    <TextView
      android:id="@+id/headline_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:textSize="18sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_ink"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:text="13:20" />
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <ImageView
    android:id="@+id/timeline_bar"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:adjustViewBounds="false"
    android:scaleType="fitXY"
    android:src="@drawable/prayer_timeline_preview"
    android:contentDescription="@string/prayer_timeline_bar_description" />
</LinearLayout>
