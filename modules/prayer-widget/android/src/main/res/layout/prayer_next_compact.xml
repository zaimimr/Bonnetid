<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_brand_background"
  android:gravity="center_vertical"
  android:paddingStart="14dp"
  android:paddingEnd="14dp"
  android:paddingTop="8dp"
  android:paddingBottom="8dp">

  <LinearLayout
    android:id="@+id/headline_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/headline_icon"
      android:layout_width="12dp"
      android:layout_height="12dp"
      android:layout_marginEnd="5dp"
      android:contentDescription="@null"
      android:tint="@color/prayer_widget_on_brand_secondary"
      android:src="@drawable/prayer_icon_dhuhr" />

    <TextView
      android:id="@+id/headline_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="12sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_on_brand_secondary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Nå · Dhuhr" />

    <ImageView
      android:id="@+id/headline_check"
      android:layout_width="11dp"
      android:layout_height="11dp"
      android:layout_marginStart="4dp"
      android:visibility="gone"
      android:tint="@color/prayer_widget_on_brand"
      android:contentDescription="@string/prayer_widget_prayed"
      android:src="@drawable/prayer_widget_check" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="bottom">

    <TextView
      android:id="@+id/headline_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="20sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_on_brand"
      android:fontFeatureSettings="tnum"
      android:letterSpacing="-0.02"
      android:maxLines="1"
      android:text="13:20" />

    <Chronometer
      android:id="@+id/countdown"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="7dp"
      android:layout_marginBottom="2dp"
      android:textSize="11sp"
      android:textColor="@color/prayer_widget_on_brand_muted"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:ellipsize="end" />
  </LinearLayout>

</LinearLayout>
