<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_background"
  android:padding="12dp">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="16sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_ink"
    android:maxLines="1"
    android:text="@string/prayer_widget_empty_title" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textSize="12sp"
    android:textColor="@color/prayer_widget_ink_secondary"
    android:text="@string/prayer_widget_empty_body" />
</LinearLayout>
