<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/tracker_item"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="horizontal"
  android:gravity="center_vertical">

    <FrameLayout
      android:id="@+id/tracker_mark"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:background="@drawable/prayer_tracker_ring">

      <ImageView
        android:id="@+id/tracker_check"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:tint="@color/prayer_widget_surface"
        android:contentDescription="@string/prayer_widget_prayed"
        android:src="@drawable/prayer_widget_check" />
    </FrameLayout>

  <TextView
    android:id="@+id/column_label"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginStart="6dp"
    android:textSize="12sp"
    android:textColor="@color/prayer_widget_ink"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="Fajr" />

  <TextView
    android:id="@+id/column_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:textSize="12sp"
    android:textColor="@color/prayer_widget_ink_muted"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:text="06:12" />
</LinearLayout>
