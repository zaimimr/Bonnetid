<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="horizontal"
  android:background="@drawable/prayer_widget_background"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical">

      <TextView
        android:id="@+id/focus_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/prayer_widget_ink_muted"
        android:maxLines="1"
        android:text="Nå" />

      <TextView
        android:id="@+id/focus_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_brand"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Asr" />

      <TextView
        android:id="@+id/focus_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_ink"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Ikke bedt ennå" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
      android:id="@+id/subtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_muted"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:text="2 av 5 i dag" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="16dp"
    android:orientation="vertical">
    <FrameLayout android:id="@+id/column_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <FrameLayout android:id="@+id/column_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <FrameLayout android:id="@+id/column_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <FrameLayout android:id="@+id/column_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <FrameLayout android:id="@+id/column_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  </LinearLayout>
</LinearLayout>
