<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_background"
  android:padding="12dp">

  <TextView
    android:id="@+id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="12sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_ink_muted"
    android:maxLines="1"
    android:text="Jamat" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

      <ImageView
        android:id="@+id/headline_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="5dp"
        android:contentDescription="@null"
        android:tint="@color/prayer_widget_brand"
        android:src="@drawable/prayer_icon_dhuhr" />

      <TextView
        android:id="@+id/headline_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_brand"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Dhuhr" />
    </LinearLayout>

    <TextView
      android:id="@+id/headline_time"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:gravity="center_vertical|start"
      android:textSize="34sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_ink"
      android:fontFeatureSettings="tnum"
      android:letterSpacing="-0.02"
      android:maxLines="1"
      android:autoSizeTextType="uniform"
      android:autoSizeMinTextSize="20sp"
      android:autoSizeMaxTextSize="34sp"
      android:text="13:30" />

    <TextView
      android:id="@+id/headline_adhan"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:text="Adhan 13:12" />
  </LinearLayout>

  <TextView
    android:id="@+id/subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="11sp"
    android:textColor="@color/prayer_widget_ink_muted"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="Moské" />
</LinearLayout>
