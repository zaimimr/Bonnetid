<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_gravity="center_vertical"
  android:orientation="vertical"
  android:gravity="center"
  android:paddingTop="7dp"
  android:paddingBottom="7dp"
  android:paddingStart="2dp"
  android:paddingEnd="2dp">

  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/column_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Fajr" />

    <ImageView
      android:id="@+id/column_check"
      android:layout_width="10dp"
      android:layout_height="10dp"
      android:layout_marginStart="3dp"
      android:visibility="gone"
      android:tint="@color/prayer_widget_brand"
      android:contentDescription="@string/prayer_widget_prayed"
      android:src="@drawable/prayer_widget_check" />
  </LinearLayout>

  <TextView
    android:id="@+id/column_time"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:gravity="center_horizontal"
    android:textSize="18sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_ink"
    android:fontFeatureSettings="tnum"
    android:letterSpacing="-0.02"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="13sp"
    android:autoSizeMaxTextSize="18sp"
    android:text="05:12" />

  <TextView
    android:id="@+id/column_jamat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:gravity="center_horizontal"
    android:textSize="11sp"
    android:textColor="@color/prayer_widget_brand"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:visibility="gone"
    android:text="05:30" />
</LinearLayout>
