<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_background"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/location"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Oslo" />

    <TextView
      android:id="@+id/hijri"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="6dp"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_muted"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="10. Rabi al-awwal" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/columns"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
      android:id="@+id/column_0"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="4dp"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingTop="6dp"
      android:paddingBottom="6dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp">

      <TextView
        android:id="@+id/column_label_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_ink_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Fajr" />

      <TextView
        android:id="@+id/column_time_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_horizontal"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_ink"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="05:12" />

      <TextView
        android:id="@+id/column_jamat_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_brand"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:visibility="gone"
        android:text="05:30" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/column_1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="4dp"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingTop="6dp"
      android:paddingBottom="6dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp">

      <TextView
        android:id="@+id/column_label_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_ink_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Fajr" />

      <TextView
        android:id="@+id/column_time_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_horizontal"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_ink"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="05:12" />

      <TextView
        android:id="@+id/column_jamat_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_brand"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:visibility="gone"
        android:text="05:30" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/column_2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="4dp"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingTop="6dp"
      android:paddingBottom="6dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp">

      <TextView
        android:id="@+id/column_label_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_ink_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Fajr" />

      <TextView
        android:id="@+id/column_time_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_horizontal"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_ink"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="05:12" />

      <TextView
        android:id="@+id/column_jamat_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_brand"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:visibility="gone"
        android:text="05:30" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/column_3"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="4dp"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingTop="6dp"
      android:paddingBottom="6dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp">

      <TextView
        android:id="@+id/column_label_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_ink_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Fajr" />

      <TextView
        android:id="@+id/column_time_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_horizontal"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_ink"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="05:12" />

      <TextView
        android:id="@+id/column_jamat_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_brand"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:visibility="gone"
        android:text="05:30" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/column_4"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="0dp"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingTop="6dp"
      android:paddingBottom="6dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp">

      <TextView
        android:id="@+id/column_label_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_ink_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Fajr" />

      <TextView
        android:id="@+id/column_time_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_horizontal"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_ink"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="05:12" />

      <TextView
        android:id="@+id/column_jamat_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="@color/prayer_widget_brand"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:visibility="gone"
        android:text="05:30" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/footer_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="4dp"
      android:textSize="12sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_brand"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Asr" />

    <Chronometer
      android:id="@+id/countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_brand"
      android:fontFeatureSettings="tnum"
      android:maxLines="1" />

    <TextView
      android:id="@+id/footer_jamat"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="5dp"
      android:textSize="11sp"
      android:textColor="@color/prayer_widget_ink_muted"
      android:maxLines="1"
      android:visibility="gone"
      android:text="· jamat" />
  </LinearLayout>
</LinearLayout>
