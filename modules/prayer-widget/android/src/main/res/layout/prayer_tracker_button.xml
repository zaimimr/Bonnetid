<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center"
  android:background="@drawable/prayer_widget_background"
  android:padding="12dp">

  <TextView
    android:id="@+id/focus_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="20sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_brand"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="Asr" />

  <FrameLayout
    android:id="@+id/tracker_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">
    <FrameLayout
      android:id="@+id/tracker_mark"
      android:layout_width="58dp"
      android:layout_height="58dp"
      android:background="@drawable/prayer_tracker_ring">

      <ImageView
        android:id="@+id/tracker_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:tint="@color/prayer_widget_surface"
        android:contentDescription="@string/prayer_widget_prayed"
        android:src="@drawable/prayer_widget_check" />
    </FrameLayout>
  </FrameLayout>

  <TextView
    android:id="@+id/focus_status"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="13sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_ink"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="Merk som bedt" />

  <TextView
    android:id="@+id/subtitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="12sp"
    android:textColor="@color/prayer_widget_ink_muted"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:text="2 av 5 i dag" />
</LinearLayout>
