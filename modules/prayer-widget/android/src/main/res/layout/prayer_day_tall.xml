<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_background"
  android:paddingStart="14dp"
  android:paddingEnd="14dp"
  android:paddingTop="16dp"
  android:paddingBottom="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:layout_width="13dp"
      android:layout_height="13dp"
      android:layout_marginEnd="6dp"
      android:contentDescription="@null"
      android:tint="@color/prayer_widget_brand"
      android:src="@drawable/prayer_widget_status_icon" />

    <TextView
      android:id="@+id/location"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Oslo" />

    <TextView
      android:id="@+id/hijri"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="6dp"
      android:gravity="end"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_muted"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="10. Rabi al-awwal" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
          android:id="@+id/headline_icon"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:layout_marginEnd="6dp"
          android:contentDescription="@null"
          android:tint="@color/prayer_widget_brand"
          android:src="@drawable/prayer_icon_dhuhr" />

        <TextView
          android:id="@+id/headline_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="@color/prayer_widget_ink_secondary"
          android:maxLines="1"
          android:ellipsize="end"
          android:text="Nå · Dhuhr" />
      </LinearLayout>

      <TextView
        android:id="@+id/headline_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_ink"
        android:fontFeatureSettings="tnum"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="22sp"
        android:autoSizeMaxTextSize="36sp"
        android:text="13:20" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:orientation="vertical">

      <Chronometer
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/prayer_widget_ink"
        android:fontFeatureSettings="tnum"
        android:maxLines="1" />

      <TextView
        android:id="@+id/countdown_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="1dp"
        android:textSize="12sp"
        android:textColor="@color/prayer_widget_ink_muted"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="til Asr 16:48" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/columns"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="2dp"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <FrameLayout
      android:id="@+id/column_0"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginEnd="3dp" />
    <FrameLayout
      android:id="@+id/column_1"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginEnd="3dp" />
    <FrameLayout
      android:id="@+id/column_2"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginEnd="3dp" />
    <FrameLayout
      android:id="@+id/column_3"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginEnd="3dp" />
    <FrameLayout
      android:id="@+id/column_4"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginEnd="0dp" />
  </LinearLayout>

</LinearLayout>
