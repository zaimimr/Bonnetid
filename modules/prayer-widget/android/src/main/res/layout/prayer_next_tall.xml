<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_brand_background"
  android:paddingStart="16dp"
  android:paddingEnd="16dp"
  android:paddingTop="16dp"
  android:paddingBottom="16dp">

  <LinearLayout
    android:id="@+id/headline_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/headline_icon"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginEnd="6dp"
      android:contentDescription="@null"
      android:tint="@color/prayer_widget_on_brand_secondary"
      android:src="@drawable/prayer_icon_dhuhr" />

    <TextView
      android:id="@+id/headline_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="15sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_on_brand_secondary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Nå · Dhuhr" />

    <ImageView
      android:id="@+id/headline_check"
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:layout_marginStart="4dp"
      android:visibility="gone"
      android:tint="@color/prayer_widget_on_brand"
      android:contentDescription="@string/prayer_widget_prayed"
      android:src="@drawable/prayer_widget_check" />
  </LinearLayout>

  <TextView
    android:id="@+id/headline_time"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:textSize="46sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_on_brand"
    android:fontFeatureSettings="tnum"
    android:letterSpacing="-0.02"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="26sp"
    android:autoSizeMaxTextSize="46sp"
    android:text="13:20" />

  <ProgressBar
    android:id="@+id/progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="4dp"
    android:max="1000"
    android:progress="420"
    android:progressDrawable="@drawable/prayer_widget_progress" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/countdown_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="4dp"
      android:textSize="13sp"
      android:textColor="@color/prayer_widget_on_brand_muted"
      android:maxLines="1"
      android:text="Asr" />

    <Chronometer
      android:id="@+id/countdown"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="13sp"
      android:textColor="@color/prayer_widget_on_brand_muted"
      android:fontFeatureSettings="tnum"
      android:maxLines="1" />
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="12dp"
    android:background="@color/prayer_widget_on_brand_track" />

  <LinearLayout
    android:id="@+id/upcoming_row_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/upcoming_icon_0"
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:layout_marginEnd="8dp"
      android:contentDescription="@null"
      android:tint="@color/prayer_widget_on_brand_muted"
      android:src="@drawable/prayer_icon_asr" />

    <TextView
      android:id="@+id/upcoming_label_0"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="14sp"
      android:textColor="@color/prayer_widget_on_brand_secondary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Asr" />

    <TextView
      android:id="@+id/upcoming_time_0"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="14sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_on_brand"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:text="16:48" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/upcoming_row_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/upcoming_icon_1"
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:layout_marginEnd="8dp"
      android:contentDescription="@null"
      android:tint="@color/prayer_widget_on_brand_muted"
      android:src="@drawable/prayer_icon_asr" />

    <TextView
      android:id="@+id/upcoming_label_1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="14sp"
      android:textColor="@color/prayer_widget_on_brand_secondary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Asr" />

    <TextView
      android:id="@+id/upcoming_time_1"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="14sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_on_brand"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:text="16:48" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/upcoming_row_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/upcoming_icon_2"
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:layout_marginEnd="8dp"
      android:contentDescription="@null"
      android:tint="@color/prayer_widget_on_brand_muted"
      android:src="@drawable/prayer_icon_asr" />

    <TextView
      android:id="@+id/upcoming_label_2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="14sp"
      android:textColor="@color/prayer_widget_on_brand_secondary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Asr" />

    <TextView
      android:id="@+id/upcoming_time_2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="14sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_on_brand"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:text="16:48" />
  </LinearLayout>
</LinearLayout>
