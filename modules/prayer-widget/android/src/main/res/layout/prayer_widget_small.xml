<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_background"
  android:padding="14dp">

  <TextView
    android:id="@+id/state"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="12sp"
    android:textColor="@color/prayer_widget_ink_muted"
    android:maxLines="1"
    android:text="Neste" />

  <LinearLayout
    android:id="@+id/headline_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/headline_icon"
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:layout_marginEnd="5dp"
      android:contentDescription="@null"
      android:tint="@color/prayer_widget_brand"
      android:src="@drawable/prayer_icon_dhuhr" />

    <TextView
      android:id="@+id/headline_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="16sp"
      android:textStyle="bold"
      android:textColor="@color/prayer_widget_brand"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Dhuhr" />

    <ImageView
      android:id="@+id/headline_check"
      android:layout_width="13dp"
      android:layout_height="13dp"
      android:layout_marginStart="4dp"
      android:visibility="gone"
      android:contentDescription="@string/prayer_widget_prayed"
      android:src="@drawable/prayer_widget_check" />
  </LinearLayout>

  <TextView
    android:id="@+id/headline_time"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:textSize="32sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_ink"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="22sp"
    android:autoSizeMaxTextSize="34sp"
    android:text="13:20" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/countdown_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="4dp"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:maxLines="1"
      android:visibility="gone"
      android:text="Isha" />

    <Chronometer
      android:id="@+id/countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:fontFeatureSettings="tnum"
      android:maxLines="1" />
  </LinearLayout>
</LinearLayout>
