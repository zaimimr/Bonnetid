<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/prayer_widget_background"
  android:gravity="center_vertical"
  android:padding="12dp">

  <TextView
    android:id="@+id/state"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="12sp"
    android:textColor="@color/prayer_widget_ink_muted"
    android:maxLines="1"
    android:text="Neste" />

  <TextView
    android:id="@+id/headline_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:textSize="16sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_brand"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="Duhr" />

  <TextView
    android:id="@+id/headline_time"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textSize="30sp"
    android:textStyle="bold"
    android:textColor="@color/prayer_widget_ink"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="20sp"
    android:autoSizeMaxTextSize="32sp"
    android:text="13:20" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/countdown_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="4dp"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:maxLines="1"
      android:visibility="gone"
      android:text="Isha" />

    <Chronometer
      android:id="@+id/countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textColor="@color/prayer_widget_ink_secondary"
      android:fontFeatureSettings="tnum"
      android:maxLines="1" />
  </LinearLayout>
</LinearLayout>
